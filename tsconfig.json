{
  "compilerOptions": {
    "target": "ES2020",
    "module": "None",
    "lib": ["ES2020", "DOM"],
    "allowJs": false,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "outDir": "js",
    "rootDir": "src",
    "removeComments": false,
    "sourceMap": false,
    "declaration": false,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
